# Safe offline default. Live modes require completed legal review and explicit
# source acknowledgements below.
DATA_SOURCE_MODE=mock
TARGET_MODE=synthetic

# Optional local PostGIS. Replace both placeholders before starting Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ottawa_infra
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# Exact live layers remain disabled until DATA_LICENSES.md review is complete.
OTTAWA_311_SERVICE_URL=
OTTAWA_WATER_NETWORK_URL=
OTTAWA_ROADS_URL=
OTTAWA_BUILDINGS_URL=
CITY_DATA_LICENSE_CONFIRMED=0

H3_RESOLUTION=8
PREDICTION_HORIZON_HOURS=48
MODEL_PATH=models/infra_stress_model.joblib

ECCC_STATION_ID=49568
ECCC_BASE_URL=https://climate.weather.gc.ca/climate_data/bulk_data_e.html
ECCC_WEATHER_START_DATE=2019-01-01
ECCC_WEATHER_END_DATE=2025-12-31
ECCC_DATA_TERMS_ACCEPTED=0
WEATHER_FORCE_REFRESH=0

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MAX_API_FEATURES=2000
MAX_BBOX_SPAN_DEGREES=0.5

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_MAX_PAGES=500
HTTP_USER_AGENT=ottawa-infra-stress/1.0 (local educational project)
